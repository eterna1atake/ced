# สภาพแวดล้อมการทำงาน เช่น development, production
NODE_ENV="development"

# Connection string สำหรับ MongoDB
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/?appName=ClusterName"

# ชื่อฐานข้อมูล MongoDB
MONGODB_DB_NAME="DatabaseName"

# Secret key สำหรับการเข้ารหัส session หรือ token ของ Auth (สร้างใหม่ได้ด้วย openssl rand -base64 32)
AUTH_SECRET="your-auth-secret-key"

# ตั้งค่าเป็น true หาก deploy บน host ที่เชื่อถือได้ (เช่น Vercel, localhost)
AUTH_TRUST_HOST=true

# Site key ของ Google reCAPTCHA (ฝั่ง Client)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your-recaptcha-site-key"

# Secret key ของ Google reCAPTCHA (ฝั่ง Server)
RECAPTCHA_SECRET_KEY="your-recaptcha-secret-key"

# Host ของ SMTP server สำหรับส่งอีเมล
SMTP_HOST=smtp.gmail.com

# Port ของ SMTP server
SMTP_PORT=587

# การใช้ SSL/TLS (true/false)
SMTP_SECURE=false

# ชื่อผู้ใช้สำหรับ SMTP Authentication
SMTP_USER="your-email@example.com"

# รหัสผ่านสำหรับ SMTP Authentication (สำหรับ Gmail อาจต้องใช้ App Password)
SMTP_PASS="your-smtp-password"

# อีเมลผู้ส่ง (Sender Address)
SMTP_FROM="Sender Name <your-email@example.com>"

# อีเมลที่อนุญาตให้ทำการรีเซ็ตระบบ หรืออีเมลของผู้ดูแลระบบหลัก
ALLOW_RESET_EMAIL="admin@example.com"

# ชื่อ Cloud Name ของ Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"

# API Key ของ Cloudinary
CLOUDINARY_API_KEY="your-api-key"

# API Secret ของ Cloudinary
CLOUDINARY_API_SECRET="your-api-secret"

# Property ID ของ Google Analytics
GA_PROPERTY_ID="your-ga-property-id"

# Measurement ID ของ Google Analytics 4 (GA4)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# อีเมล Service Account ของ Google Cloud Platform
GOOGLE_CLIENT_EMAIL="your-service-account@project.iam.gserviceaccount.com"

# Private Key ของ Google Service Account (ต้องจัดการเรื่อง \n ให้ถูกต้อง)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# URL หลักของโปรเจกต์
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public Key สำหรับการยืนยันตัวตน (ถ้าใช้ RSA)
AUTH_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Private Key สำหรับการยืนยันตัวตน (ถ้าใช้ RSA)
AUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# อีเมลของผู้ดูแลระบบ
ADMIN_EMAIL="admin@example.com"
